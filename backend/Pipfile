[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "*"
flask-restful = "*"
flask-sqlalchemy = "*"
opencv-python = "==4.10.*"

[dev-packages]
autopep8 = "*"
rope = "*"
flake8 = "*"

[requires]
python_version = "3.14"
python_full_version = "3.14.7"

[scripts]
start = "python yukari.py '../frontend/dist/'"
help = "python yukari.py -h"
test = "python -m unittest discover -v"
format = "autopep8 -ivr ."
lint = "flake8 --show-source ."
